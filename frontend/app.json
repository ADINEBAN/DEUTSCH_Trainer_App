{
  "expo": {
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E9F2FB"
      },
      "package": "com.adineban.deutschtrainer",
      "edgeToEdgeEnabled": true,
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO",
        "READ_EXTERNAL_STORAGE"
      ],
      "predictiveBackGestureEnabled": false
    },
    "androidStatusBar": {
      "backgroundColor": "#00000000",
      "barStyle": "dark-content",
      "translucent": true
    },
    "androidNavigationBar": {
      "backgroundColor": "#00000000",
      "barStyle": "dark-content"
    },
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "bundleIdentifier": "com.adineban.deutschtrainer",
      "supportsTablet": true
    },
    "name": "Deutsch Trainer",
    "orientation": "portrait",
    "plugins": [
      "expo-router",
      "expo-audio",
      "expo-splash-screen",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Cho phép Deutsch Trainer dùng camera để chụp ảnh học từ mới.",
          "photosPermission": "Cho phép Deutsch Trainer truy cập ảnh để học từ qua ảnh chụp."
        }
      ],
      "expo-document-picker",
      [
        "expo-navigation-bar",
        {
          "position": "absolute",
          "backgroundColor": "#00000000",
          "barStyle": "dark-content"
        }
      ]
    ],
    "scheme": "deutschtrainer",
    "slug": "deutsch-trainer-app",
    "updates": {
      "checkAutomatically": "ON_LOAD",
      "enabled": true,
      "url": "https://u.expo.dev/00000000-0000-0000-0000-000000000000"
    },
    "userInterfaceStyle": "light",
    "version": "1.0.0",
    "web": {
      "bundler": "metro",
      "output": "static"
    }
  }
}